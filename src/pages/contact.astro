---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MapBlock from '../components/MapBlock.astro';
import { COMPANY } from '../lib/site';

// 2026-10 미팅: 개인정보 수집 책임 문제로 문의 양식은 두지 않는다 — 연락처와 지도만 안내한다.
const ROWS = [
  { k: '주소', v: COMPANY.address },
  { k: '전화', v: COMPANY.tel, href: `tel:${COMPANY.tel.replace(/-/g, '')}` },
  { k: '팩스', v: COMPANY.fax },
  { k: '이메일', v: COMPANY.email, href: `mailto:${COMPANY.email}` },
];
---

<Base title="오시는 길" description={`${COMPANY.nameKoShort} 오시는 길과 연락처 안내입니다.`}>
  <PageHero
    en="Contact"
    title="오시는 길"
    desc="투자 검토를 원하시면 회사소개자료를 이메일로 보내주세요. 담당자가 확인 후 회신드립니다."
  />

  <section class="section">
    <div class="wrap cc">
      <div class="cc__map reveal">
        <MapBlock />
      </div>

      <div class="cc__info reveal" data-delay="1">
        <p class="label">Location</p>
        <h2 class="h2" style="margin-top:14px">{COMPANY.nameKoShort}</h2>
        <dl class="cinfo">
          {ROWS.map((r) => (
            <div>
              <dt>{r.k}</dt>
              <dd class="num">{r.href ? <a href={r.href}>{r.v}</a> : r.v}</dd>
            </div>
          ))}
        </dl>
        <a class="btn btn--primary" style="margin-top:28px" href={`mailto:${COMPANY.email}?subject=${encodeURIComponent('[회사소개자료] 회사명 / 담당자')}`}>
          회사소개자료 보내기 <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="cc__note">메일 앱이 열리지 않으면 {COMPANY.email} 로 직접 보내주세요.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .cc {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  @media (max-width: 900px) { .cc { grid-template-columns: 1fr; } }
  .cinfo { margin: 26px 0 0; border-top: 2px solid var(--ink); }
  .cinfo > div {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 16px;
    padding: 17px 2px;
    border-bottom: 1px solid var(--line);
  }
  .cinfo dt { font-size: 0.9375rem; font-weight: 600; color: var(--muted-2); }
  .cinfo dd { margin: 0; font-size: 1.0625rem; font-weight: 500; }
  .cinfo a { color: var(--blue); text-decoration: none; }
  .cinfo a:hover { text-decoration: underline; }
  .cc__note { margin-top: 12px; font-size: 0.875rem; color: var(--muted-2); }
</style>
