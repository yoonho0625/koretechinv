---
import Admin from '../../layouts/Admin.astro';
import { envOf } from '../../lib/server';

export const prerender = false;

const env = envOf(Astro.locals);
const [n, p, f, logs] = await Promise.all([
  env.DB.prepare('SELECT COUNT(*) AS all_, SUM(published) AS pub FROM notices').first<{ all_: number; pub: number | null }>(),
  env.DB.prepare('SELECT COUNT(*) AS all_, SUM(published) AS pub FROM portfolio').first<{ all_: number; pub: number | null }>(),
  env.DB.prepare('SELECT COUNT(*) AS c, COALESCE(SUM(size),0) AS bytes FROM files').first<{ c: number; bytes: number }>(),
  env.DB.prepare('SELECT * FROM audit_log ORDER BY id DESC LIMIT 12').all<{ admin: string; action: string; target: string; at: string }>(),
]);
const ACTION: Record<string, string> = {
  login: '로그인',
  'notice.create': '공지 등록',
  'notice.update': '공지 수정',
  'notice.delete': '공지 삭제',
  'portfolio.create': '포트폴리오 등록',
  'portfolio.update': '포트폴리오 수정',
  'portfolio.delete': '포트폴리오 삭제',
  'admin.create': '관리자 추가',
  'admin.delete': '관리자 삭제',
  'admin.password': '비밀번호 변경',
};
const kst = (s: string) => new Date(s.replace(' ', 'T') + 'Z').toLocaleString('ko-KR', { timeZone: 'Asia/Seoul', dateStyle: 'short', timeStyle: 'short' });
---

<Admin title="대시보드" active="home">
  <div class="a-head">
    <div>
      <h1>대시보드</h1>
      <p>공지사항과 포트폴리오는 저장하는 즉시 홈페이지에 반영됩니다.</p>
    </div>
    <a class="a-btn a-btn--primary" href="/admin/notices/new">+ 새 공지 쓰기</a>
  </div>

  <div class="stats">
    <a class="stat a-card" href="/admin/notices">
      <span class="stat__k">공지사항</span>
      <span class="stat__v">{n?.all_ ?? 0}<em>건</em></span>
      <span class="stat__s">공개 {n?.pub ?? 0} · 작성중 {(n?.all_ ?? 0) - (n?.pub ?? 0)}</span>
    </a>
    <a class="stat a-card" href="/admin/portfolio">
      <span class="stat__k">포트폴리오</span>
      <span class="stat__v">{p?.all_ ?? 0}<em>건</em></span>
      <span class="stat__s">공개 {p?.pub ?? 0} · 작성중 {(p?.all_ ?? 0) - (p?.pub ?? 0)}</span>
    </a>
    <div class="stat a-card">
      <span class="stat__k">첨부파일</span>
      <span class="stat__v">{f?.c ?? 0}<em>개</em></span>
      <span class="stat__s">{((f?.bytes ?? 0) / 1048576).toFixed(1)}MB 사용</span>
    </div>
  </div>

  <section class="a-card" style="margin-top:16px">
    <h2 class="sub">최근 활동</h2>
    {(logs.results ?? []).length === 0 ? (
      <p class="muted">기록이 없습니다.</p>
    ) : (
      <div class="a-scroll">
        <table class="a-table">
          <thead><tr><th>시각</th><th>관리자</th><th>작업</th><th>대상</th></tr></thead>
          <tbody>
            {(logs.results ?? []).map((l) => (
              <tr><td class="num">{kst(l.at)}</td><td>{l.admin}</td><td>{ACTION[l.action] ?? l.action}</td><td>{l.action === 'login' ? '' : l.target}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</Admin>

<style>
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .stat { display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: inherit; }
  a.stat:hover { border-color: var(--blue-200); }
  .stat__k { font-size: 0.875rem; font-weight: 700; color: var(--muted-2); }
  .stat__v { font-size: 2rem; font-weight: 700; letter-spacing: -0.03em; }
  .stat__v em { font-style: normal; font-size: 1rem; color: var(--muted); margin-left: 3px; }
  .stat__s { font-size: 0.875rem; color: var(--muted); }
  .sub { font-size: 1.0625rem; margin-bottom: 12px; }
  .muted { color: var(--muted-2); font-size: 0.9375rem; }
  @media (max-width: 760px) { .stats { grid-template-columns: 1fr; } }
</style>
