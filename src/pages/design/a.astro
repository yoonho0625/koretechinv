---
/**
 * 시안 A — INK MONOLITH
 * CI 블랙(#1B161C)을 바탕색 그 자체로 쓰는 에디토리얼. 레드·블루는 점 하나·선 하나 크기로만.
 * 큰 활자, 스크롤에 따라 단어가 켜지는 선언문, 외곽선 활자 띠, 반전되는 업무 행.
 */
import Base from '../../layouts/Base.astro';
import HeroJourney from '../../components/HeroJourney.astro';
import MapBlock from '../../components/MapBlock.astro';
import { COMPANY, PROCESS, SECTORS, SERVICES } from '../../lib/site';
import { loadHome } from '../../lib/home';
import { fmtDate } from '../../lib/server';

export const prerender = false;
const { notices, portfolio } = await loadHome(Astro.locals);
const MANIFESTO = '대한민국의 산업을 바꿀 핵심 기술을 찾고, 그 기술이 사업이 될 때까지 곁에 있겠습니다.';
---

<Base title="시안 A · INK MONOLITH" kt="ink" transparentHeader noindex>
  <HeroJourney theme="ink" />

  <!-- 선언문: 스크롤에 따라 단어가 하나씩 켜진다 -->
  <section class="ink manifesto" data-manifesto data-dark>
    <div class="wrap">
      <p class="eyebrow"><i></i>Our conviction</p>
      <p class="manifesto__text">
        {MANIFESTO.split(' ').map((w) => <span class="w">{w} </span>)}
      </p>
      <dl class="facts">
        <div><dt>설립</dt><dd class="num">2026.06.05</dd></div>
        <div><dt>업종</dt><dd>{COMPANY.business}</dd></div>
        <div><dt>소재지</dt><dd>서울 강남 · NK타워</dd></div>
      </dl>
    </div>
  </section>

  <!-- 외곽선 활자 띠 -->
  <div class="ink outline-band" aria-hidden="true" data-dark>
    <div class="outline-band__track">
      {[0, 1].map(() => <span>KORETECH <b>·</b> KOREA <b>·</b> CORE <b>·</b> TECHNOLOGY <b>·</b> </span>)}
    </div>
  </div>

  <!-- 업무영역: 왼쪽 고정 제목 + 오른쪽 반전 행 -->
  <section class="paper biz">
    <div class="wrap biz__grid">
      <div class="biz__head">
        <p class="eyebrow eyebrow--dark"><i></i>Business area</p>
        <h2 class="big">세 가지 방식으로<br />함께합니다.</h2>
        <p class="biz__lead">자본과 부채, 그리고 그 이후의 동행까지. 기업의 단계에 맞는 방식으로 지원합니다.</p>
      </div>
      <ol class="rows">
        {SERVICES.map((s, i) => (
          <li class="row">
            <span class="row__no">{String(i + 1).padStart(2, '0')}</span>
            <div class="row__body">
              <h3>{s.title} <em>{s.en}</em></h3>
              <p>{s.desc}</p>
              <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
            </div>
            <span class="row__arrow" aria-hidden="true">↗</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 투자 프로세스: 스크롤에 따라 선이 차오른다 -->
  <section class="ink process" data-track data-dark>
    <div class="wrap">
      <p class="eyebrow"><i></i>Investment process</p>
      <h2 class="big big--light">발굴에서 사후관리까지,<br /><span>다섯 단계.</span></h2>
      <div class="track">
        <span class="track__line"><span class="track__fill" data-fill></span></span>
        <ol class="track__steps">
          {PROCESS.map((p) => (
            <li>
              <span class="track__dot"></span>
              <span class="track__no">{p.step}</span>
              <h3>{p.title}</h3>
              <p class="track__en">{p.en}</p>
              <p class="track__desc">{p.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 포트폴리오 · 공지 -->
  <section class="paper news">
    <div class="wrap news__grid">
      <div>
        <div class="news__head"><h2>Portfolio</h2><a href="/portfolio">전체 ↗</a></div>
        {portfolio.length === 0 ? (
          <div class="pf-empty">
            <p class="pf-empty__t">포트폴리오를 준비하고 있습니다.</p>
            <p class="pf-empty__s">관심 분야</p>
            <p class="pf-empty__chips">{SECTORS.map((s) => <span>{s}</span>)}</p>
          </div>
        ) : (
          <ul class="tbl">{portfolio.map((p) => <li><a href={`/portfolio/${p.id}`}><span>{p.company}</span><em>{p.sector}</em></a></li>)}</ul>
        )}
      </div>
      <div>
        <div class="news__head"><h2>Notice</h2><a href="/notice">전체 ↗</a></div>
        {notices.length === 0 ? (
          <p class="tbl-empty">등록된 공지가 없습니다.</p>
        ) : (
          <ul class="tbl">
            {notices.map((n) => (
              <li><a href={`/notice/${n.id}`}><span>{n.title}</span><em class="num">{fmtDate(n.post_date)}</em></a></li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>

  <!-- 오시는 길 -->
  <section class="ink contact" data-dark>
    <div class="wrap contact__grid">
      <div>
        <p class="eyebrow"><i></i>Contact</p>
        <h2 class="big big--light">함께 성장할 기업을<br /><span>기다립니다.</span></h2>
        <dl class="contact__dl">
          <div><dt>주소</dt><dd>{COMPANY.address}</dd></div>
          <div><dt>전화</dt><dd class="num"><a href={`tel:${COMPANY.tel.replace(/-/g, '')}`}>{COMPANY.tel}</a></dd></div>
          <div><dt>팩스</dt><dd class="num">{COMPANY.fax}</dd></div>
          <div><dt>메일</dt><dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd></div>
        </dl>
      </div>
      <div class="contact__map"><MapBlock dark /></div>
    </div>
  </section>
</Base>

<style>
  .ink { background: #1b161c; color: #f4f1ee; }
  .paper { background: #f4f1ee; color: #1b161c; }
  .wrap { max-width: 1280px; }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 12px; margin: 0 0 28px;
    font-family: Sora, Pretendard, sans-serif; font-size: 0.875rem; font-weight: 600;
    letter-spacing: 0.24em; text-transform: uppercase; color: #c9ced8;
  }
  .eyebrow i { width: 8px; height: 8px; border-radius: 50%; background: var(--red); }
  .eyebrow--dark { color: #5f5658; }
  .big { font-size: clamp(2.25rem, 5.4vw, 4.75rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.055em; }
  .big--light span { color: #8a8083; }

  /* 선언문 */
  .manifesto { padding-block: clamp(110px, 16vw, 220px) clamp(80px, 10vw, 140px); }
  .manifesto__text {
    max-width: 22ch;
    font-size: clamp(2.125rem, 5.6vw, 5.25rem);
    font-weight: 800; line-height: 1.16; letter-spacing: -0.05em;
  }
  .manifesto__text .w { opacity: 0.16; transition: opacity 0.35s ease; }
  .manifesto__text .w.on { opacity: 1; }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: clamp(56px, 8vw, 96px) 0 0; border-top: 1px solid rgba(244, 241, 238, 0.18); }
  .facts > div { padding: 22px 0 0; }
  .facts > div + div { padding-left: 24px; border-left: 1px solid rgba(244, 241, 238, 0.12); }
  .facts dt { font-family: Sora, Pretendard, sans-serif; font-size: 0.8125rem; letter-spacing: 0.16em; color: #8a8083; }
  .facts dd { margin: 8px 0 0; font-size: clamp(1.125rem, 1.8vw, 1.5rem); font-weight: 700; letter-spacing: -0.02em; }

  /* 외곽선 띠 */
  .outline-band { overflow: hidden; padding-block: 18px 40px; }
  .outline-band__track { display: flex; width: max-content; animation: band 46s linear infinite; }
  .outline-band span {
    font-family: Sora, Pretendard, sans-serif; font-weight: 800; white-space: nowrap;
    font-size: clamp(4rem, 11vw, 10rem); letter-spacing: -0.04em; line-height: 1;
    color: transparent; -webkit-text-stroke: 1.5px rgba(244, 241, 238, 0.32);
  }
  .outline-band b { color: var(--red); -webkit-text-stroke: 0; }
  @keyframes band { to { transform: translateX(-50%); } }

  /* 업무영역 */
  .biz { padding-block: clamp(90px, 12vw, 160px); }
  .biz__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .biz__head { position: sticky; top: 120px; }
  .biz__lead { margin-top: 24px; max-width: 30ch; font-size: 1.125rem; line-height: 1.75; color: #5f5658; }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 2px solid #1b161c; }
  .row {
    display: grid; grid-template-columns: 110px minmax(0, 1fr) 40px; gap: 18px; align-items: start;
    padding: 34px 20px; border-bottom: 1px solid #c9c0b9;
    transition: background 0.35s var(--ease-out), color 0.35s var(--ease-out);
  }
  .row:hover { background: #1b161c; color: #f4f1ee; }
  .row__no {
    font-family: Sora, Pretendard, sans-serif; font-weight: 800; font-size: 4rem; line-height: 0.9; letter-spacing: -0.05em;
    color: transparent; -webkit-text-stroke: 1.5px currentColor; opacity: 0.55;
  }
  .row:hover .row__no { -webkit-text-stroke-color: var(--red); opacity: 1; }
  .row h3 { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.04em; }
  .row h3 em { font-style: normal; font-family: Sora, Pretendard, sans-serif; font-size: 0.875rem; font-weight: 500; letter-spacing: 0.04em; color: #8a8083; margin-left: 10px; }
  .row p { margin-top: 12px; font-size: 1.0625rem; line-height: 1.75; color: inherit; opacity: 0.78; }
  .row ul { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .row li { padding: 6px 14px; border: 1px solid currentColor; border-radius: 999px; font-size: 0.875rem; opacity: 0.7; }
  .row__arrow { font-size: 1.5rem; opacity: 0; transform: translate(-6px, 6px); transition: all 0.3s var(--ease-out); }
  .row:hover .row__arrow { opacity: 1; transform: none; color: var(--red); }

  /* 프로세스 */
  .process { padding-block: clamp(100px, 13vw, 180px); }
  .track { position: relative; margin-top: clamp(56px, 7vw, 88px); }
  .track__line { position: absolute; left: 0; right: 0; top: 7px; height: 1px; background: rgba(244, 241, 238, 0.16); }
  .track__fill { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #f4f1ee, var(--red)); }
  .track__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px; }
  .track__dot { display: block; width: 15px; height: 15px; border-radius: 50%; background: #1b161c; border: 1.5px solid rgba(244, 241, 238, 0.5); margin-bottom: 28px; position: relative; }
  .track__steps li.on .track__dot { background: var(--red); border-color: var(--red); box-shadow: 0 0 0 6px rgba(194, 55, 55, 0.18); }
  .track__no { font-family: Sora, Pretendard, sans-serif; font-weight: 800; font-size: 3.25rem; line-height: 1; letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1.2px rgba(244, 241, 238, 0.5); }
  .track h3 { margin-top: 16px; font-size: 1.3125rem; font-weight: 700; }
  .track__en { margin-top: 4px; font-family: Sora, Pretendard, sans-serif; font-size: 0.8125rem; color: #8a8083; }
  .track__desc { margin-top: 12px; font-size: 0.9375rem; line-height: 1.7; color: rgba(244, 241, 238, 0.7); }

  /* 포트폴리오 · 공지 */
  .news { padding-block: clamp(90px, 11vw, 150px); }
  .news__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 6vw, 88px); }
  .news__head { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 3px solid #1b161c; padding-bottom: 14px; }
  .news__head h2 { font-family: Sora, Pretendard, sans-serif; font-size: clamp(2rem, 3.4vw, 3rem); font-weight: 800; letter-spacing: -0.05em; }
  .news__head a { font-weight: 700; color: #1b161c; text-decoration: none; }
  .news__head a:hover { color: var(--red); }
  .tbl { list-style: none; margin: 0; padding: 0; }
  .tbl a { display: flex; justify-content: space-between; gap: 18px; padding: 20px 4px; border-bottom: 1px solid #c9c0b9; text-decoration: none; color: inherit; font-size: 1.0625rem; font-weight: 600; }
  .tbl a:hover span { text-decoration: underline; text-underline-offset: 5px; }
  .tbl em { font-style: normal; font-weight: 400; color: #8a8083; white-space: nowrap; font-family: Sora, Pretendard, sans-serif; font-size: 0.9375rem; }
  .tbl-empty { padding: 28px 4px; color: #8a8083; }
  .pf-empty { padding: 28px 0 0; }
  .pf-empty__t { font-size: 1.25rem; font-weight: 700; }
  .pf-empty__s { margin-top: 22px; font-family: Sora, Pretendard, sans-serif; font-size: 0.8125rem; letter-spacing: 0.16em; color: #8a8083; text-transform: uppercase; }
  .pf-empty__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .pf-empty__chips span { padding: 7px 14px; border-radius: 999px; background: #1b161c; color: #f4f1ee; font-size: 0.875rem; }

  /* 오시는 길 */
  .contact { padding-block: clamp(100px, 12vw, 170px); }
  .contact__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(36px, 6vw, 80px); align-items: center; }
  .contact__dl { margin: 40px 0 0; }
  .contact__dl > div { display: grid; grid-template-columns: 70px minmax(0, 1fr); padding: 15px 0; border-top: 1px solid rgba(244, 241, 238, 0.14); }
  .contact__dl dt { font-weight: 700; color: #8a8083; font-size: 0.9375rem; }
  .contact__dl dd { margin: 0; font-size: 1.0625rem; }
  .contact__dl a { color: inherit; text-decoration: none; }
  .contact__map :global(.mapb__frame) { filter: grayscale(1) contrast(1.05); border-radius: 4px; }

  @media (max-width: 900px) {
    .facts { grid-template-columns: 1fr; }
    .facts > div + div { padding-left: 0; border-left: 0; border-top: 1px solid rgba(244, 241, 238, 0.12); margin-top: 18px; }
    .biz__grid, .news__grid, .contact__grid { grid-template-columns: 1fr; }
    .biz__head { position: static; }
    .row { grid-template-columns: 64px minmax(0, 1fr); padding: 26px 8px; }
    .row__no { font-size: 2.5rem; }
    .row__arrow { display: none; }
    .track__line { display: none; }
    .track__steps { grid-template-columns: 1fr; gap: 34px; }
    .track__dot { margin-bottom: 14px; }
  }
</style>

<script>
  // 선언문 단어 켜기 · 프로세스 선 채우기 (스크롤 연동)
  const words = Array.from(document.querySelectorAll<HTMLElement>('[data-manifesto] .w'));
  const manifesto = document.querySelector<HTMLElement>('[data-manifesto]');
  const track = document.querySelector<HTMLElement>('[data-track]');
  const fill = document.querySelector<HTMLElement>('[data-fill]');
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.track__steps li'));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tick = () => {
    const vh = innerHeight;
    if (manifesto) {
      const r = manifesto.getBoundingClientRect();
      const p = reduce ? 1 : Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height * 0.75)));
      const n = Math.round(p * words.length);
      words.forEach((w, i) => w.classList.toggle('on', i < n));
    }
    if (track && fill) {
      const r = track.getBoundingClientRect();
      const p = reduce ? 1 : Math.min(1, Math.max(0, (vh * 0.75 - r.top) / (r.height * 0.7)));
      fill.style.width = `${p * 100}%`;
      steps.forEach((s, i) => s.classList.toggle('on', p >= i / (steps.length - 1) - 0.02));
    }
  };
  addEventListener('scroll', tick, { passive: true });
  addEventListener('resize', tick);
  tick();
</script>
