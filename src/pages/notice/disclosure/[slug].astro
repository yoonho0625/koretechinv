---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { url } from '../../../lib/site';

export async function getStaticPaths() {
  const items = (await getCollection('disclosure')).filter((d) => !d.data.draft);
  const sorted = items.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<Base title={entry.data.title} description={`경영공시 — ${entry.data.title}`}>
  <PageHero en="Disclosure" title="경영공시" group="Notice" />

  <article class="section">
    <div class="wrap">
      <header class="post__head">
        <span class="chip">{entry.data.category}</span>
        <h2 class="post__title">{entry.data.title}</h2>
        <p class="post__date num">{fmt(entry.data.date)}</p>
      </header>

      {entry.data.files.length > 0 && (
        <div class="files">
          <p class="files__label">첨부파일</p>
          <ul class="files__list">
            {entry.data.files.map((f) => (
              <li>
                <a href={url(f.file)} download>
                  <span class="files__icon" aria-hidden="true">↓</span>
                  <span class="files__name">{f.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="prose post__body">
        <Content />
      </div>

      <nav class="pager" aria-label="이전 다음 글">
        {prev ? (
          <a class="pager__a" href={url(`/notice/disclosure/${prev.id}`)}>
            <span>이전 글</span><strong>{prev.data.title}</strong>
          </a>
        ) : <span class="pager__a is-off"><span>이전 글</span><strong>없음</strong></span>}
        <a class="pager__list" href={url('/notice/disclosure')}>목록</a>
        {next ? (
          <a class="pager__a pager__a--next" href={url(`/notice/disclosure/${next.id}`)}>
            <span>다음 글</span><strong>{next.data.title}</strong>
          </a>
        ) : <span class="pager__a pager__a--next is-off"><span>다음 글</span><strong>없음</strong></span>}
      </nav>
    </div>
  </article>
</Base>

