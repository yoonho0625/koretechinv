---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { url } from '../../../lib/site';

export async function getStaticPaths() {
  const items = (await getCollection('news')).filter((n) => !n.data.draft);
  const sorted = items.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const fmt = (x: Date) =>
  `${x.getFullYear()}.${String(x.getMonth() + 1).padStart(2, '0')}.${String(x.getDate()).padStart(2, '0')}`;
---

<Base title={d.title} description={d.summary ?? d.title}>
  <PageHero en="News" title="뉴스" group="Notice" />

  <article class="section">
    <div class="wrap">
      <header class="post__head">
        {d.source && <span class="chip">{d.source}</span>}
        <h2 class="post__title">{d.title}</h2>
        <p class="post__date num">{fmt(d.date)}</p>
      </header>

      {d.thumbnail && <img class="post__cover" src={url(d.thumbnail)} alt="" />}

      {d.files.length > 0 && (
        <div class="files">
          <p class="files__label">첨부파일</p>
          <ul class="files__list">
            {d.files.map((f) => (
              <li>
                <a href={url(f.file)} download>
                  <span class="files__icon" aria-hidden="true">↓</span>
                  <span class="files__name">{f.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="prose post__body">
        <Content />
      </div>

      {d.link && (
        <p style="margin-bottom:40px">
          <a class="btn btn--primary" href={d.link} target="_blank" rel="noopener noreferrer">
            원문 기사 보기 <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </p>
      )}

      <nav class="pager" aria-label="이전 다음 글">
        {prev ? (
          <a class="pager__a" href={url(`/notice/news/${prev.id}`)}>
            <span>이전 글</span><strong>{prev.data.title}</strong>
          </a>
        ) : <span class="pager__a is-off"><span>이전 글</span><strong>없음</strong></span>}
        <a class="pager__list" href={url('/notice/news')}>목록</a>
        {next ? (
          <a class="pager__a pager__a--next" href={url(`/notice/news/${next.id}`)}>
            <span>다음 글</span><strong>{next.data.title}</strong>
          </a>
        ) : <span class="pager__a pager__a--next is-off"><span>다음 글</span><strong>없음</strong></span>}
      </nav>
    </div>
  </article>
</Base>

<style>
  .post__cover { margin-top: 30px; width: 100%; }
</style>
