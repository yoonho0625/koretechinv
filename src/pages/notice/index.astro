---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { envOf, fmtDate, NOTICE_CATEGORIES, type Notice } from '../../lib/server';

export const prerender = false;

const PER = 10;
const env = envOf(Astro.locals);
const cat = Astro.url.searchParams.get('cat') ?? '';
const category = (NOTICE_CATEGORIES as readonly string[]).includes(cat) ? cat : '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const where = category ? 'WHERE n.published = 1 AND n.category = ?' : 'WHERE n.published = 1';
const binds = category ? [category] : [];
const total = (await env.DB.prepare(`SELECT COUNT(*) AS c FROM notices n ${where}`).bind(...binds).first<{ c: number }>())?.c ?? 0;
const pages = Math.max(1, Math.ceil(total / PER));
const rows =
  (
    await env.DB.prepare(
      `SELECT n.*, (SELECT COUNT(*) FROM files f WHERE f.owner = 'notice' AND f.owner_id = n.id) AS file_count
         FROM notices n ${where}
        ORDER BY n.pinned DESC, n.post_date DESC, n.id DESC LIMIT ? OFFSET ?`
    )
      .bind(...binds, PER, (page - 1) * PER)
      .all<Notice & { file_count: number }>()
  ).results ?? [];

const usedCats = (
  (await env.DB.prepare('SELECT DISTINCT category FROM notices WHERE published = 1').all<{ category: string }>()).results ?? []
).map((r) => r.category);
const link = (c: string, p = 1) => {
  const q = new URLSearchParams();
  if (c) q.set('cat', c);
  if (p > 1) q.set('page', String(p));
  const s = q.toString();
  return `/notice${s ? `?${s}` : ''}`;
};

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=60');
---

<Base title="공지사항" description="코어테크인베스트먼트의 공지사항과 경영공시입니다.">
  <PageHero en="Notice" title="공지사항" desc="경영공시와 회사 소식을 알려드립니다." />

  <section class="section">
    <div class="wrap">
      {usedCats.length > 1 && (
        <nav class="filters" aria-label="분류">
          <a class:list={['filter', !category && 'is-on']} href={link('')}>전체</a>
          {NOTICE_CATEGORIES.filter((c) => usedCats.includes(c)).map((c) => (
            <a class:list={['filter', category === c && 'is-on']} href={link(c)}>{c}</a>
          ))}
        </nav>
      )}

      {rows.length === 0 ? (
        <p class="empty">등록된 공지가 없습니다.</p>
      ) : (
        <div class="list">
          {rows.map((n) => (
            <a class="list__row" href={`/notice/${n.id}`}>
              <span>
                <span class="list__title">
                  {n.pinned ? <span class="chip chip--pin">중요</span> : null}
                  {n.title}
                </span>
                <span class="list__tags">
                  <span class="chip">{n.category}</span>
                  {n.file_count > 0 && <span class="chip chip--file">첨부 {n.file_count}</span>}
                </span>
              </span>
              <span class="list__meta">{fmtDate(n.post_date)}</span>
            </a>
          ))}
        </div>
      )}

      {pages > 1 && (
        <nav class="pg" aria-label="페이지">
          {Array.from({ length: pages }, (_, i) => i + 1).map((p) => (
            <a class:list={['pg__a', p === page && 'is-on']} href={link(category, p)} aria-current={p === page ? 'page' : undefined}>{p}</a>
          ))}
        </nav>
      )}
    </div>
  </section>
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 26px; }
  .filter {
    padding: 9px 18px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-2);
    background: var(--paper);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
  }
  .filter:hover { border-color: var(--ink); color: var(--ink); }
  .filter.is-on { background: var(--ink); border-color: var(--ink); color: #fff; }
  .pg { display: flex; justify-content: center; gap: 6px; margin-top: 36px; }
  .pg__a {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    border-radius: var(--r-pill);
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration: none;
  }
  .pg__a:hover { background: var(--surface); }
  .pg__a.is-on { background: var(--ink); color: #fff; }
</style>
