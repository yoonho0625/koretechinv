---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroJourney from '../components/HeroJourney.astro';
import { COMPANY, PROCESS, SECTORS, SERVICES, url } from '../lib/site';

const live = <T extends { data: { draft?: boolean } }>(c: T[]) => c.filter((e) => !e.data.draft);

const disclosures = live(await getCollection('disclosure'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const news = live(await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const portfolio = live(await getCollection('portfolio'))
  .sort((a, b) => b.data.order - a.data.order)
  .slice(0, 6);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<Base transparentHeader>
  <HeroJourney />

  <!-- 관심 분야 띠 ------------------------------------------------------- -->
  <div class="marquee" aria-label="주요 관심 투자 분야">
    <div class="marquee__track">
      {[0, 1].map(() => SECTORS.map((s) => <span class="marquee__item">{s}</span>))}
    </div>
  </div>

  <!-- ABOUT ------------------------------------------------------------- -->
  <section class="section" id="about">
    <div class="wrap grid-editorial">
      <p class="label reveal">About us</p>
      <div>
        <h2 class="h2 reveal">
          코어테크인베스트먼트는<br />
          <span class="grad-text">핵심 기술</span>에 투자하는<br />
          신기술사업금융회사입니다.
        </h2>
        <p class="lead reveal" data-delay="1" style="margin-top:28px">
          신기술사업자 및 벤처기업에 대한 다양한 방법의 투자 또는 융자와
          경영 및 기술의 지도를 전문으로 합니다.
        </p>
        <a class="btn btn--ghost reveal" data-delay="2" style="margin-top:34px" href={url('/about/overview')}>
          회사소개 <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 지표 (벤토 그리드) --------------------------------------------------- -->
  <section class="section section--tint">
    <div class="wrap">
      <div class="bento reveal">
        <article class="bento__tile bento__tile--hero">
          <p class="bento__k">납입자본금</p>
          <p class="bento__big">
            <span class="num" data-count="120">0</span><em>억원</em>
          </p>
          <p class="bento__note">
            2026년 6월 설립 후 유상증자를 통해 납입자본금 120억원을 확보했습니다.
          </p>
          <span class="bento__orb" aria-hidden="true"></span>
        </article>

        <article class="bento__tile">
          <p class="bento__k">설립</p>
          <p class="bento__v"><span class="num" data-count="2026" data-plain="1">0</span>.06</p>
        </article>

        <article class="bento__tile">
          <p class="bento__k">업무영역</p>
          <p class="bento__v bento__v--sm">신기술사업금융업</p>
        </article>

        <article class="bento__tile">
          <p class="bento__k">주주구성</p>
          <p class="bento__v bento__v--sm">㈜엘아이아이씨엠 <span class="num">100</span>%</p>
        </article>

        <article class="bento__tile">
          <p class="bento__k">대표이사</p>
          <p class="bento__v bento__v--sm">{COMPANY.ceo}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 업무영역 ----------------------------------------------------------- -->
  <section class="section">
    <div class="wrap">
      <div class="grid-editorial">
        <p class="label reveal">Business area</p>
        <div>
          <h2 class="h2 reveal">업무영역</h2>
          <p class="lead reveal" data-delay="1" style="margin-top:18px">
            자본과 부채, 그리고 그 이후의 동행까지.<br />기업의 단계에 맞는 방식으로 지원합니다.
          </p>
        </div>
      </div>

      <div class="cards">
        {SERVICES.map((s, i) => (
          <article class="card card-surface reveal" data-delay={String(i)}>
            <span class="card__no">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="card__h">{s.title}</h3>
            <p class="card__en">{s.en}</p>
            <p class="card__desc">{s.desc}</p>
            <ul class="card__list">
              {s.items.map((it) => <li>{it}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 투자 프로세스 (다크) ------------------------------------------------- -->
  <section class="section dark-bg">
    <div class="wrap">
      <div class="grid-editorial">
        <p class="label label--onDark reveal">Investment process</p>
        <div>
          <h2 class="h2 reveal" style="color:#fff">투자 프로세스</h2>
          <p class="reveal" data-delay="1" style="margin-top:18px;max-width:34em;font-weight:300;color:rgba(255,255,255,.7);font-size:clamp(1rem,1.4vw,1.25rem)">
            발굴부터 사후관리까지, 정해진 절차에 따라 투명하게 검토합니다.
          </p>
        </div>
      </div>

      <ol class="steps">
        {PROCESS.map((p, i) => (
          <li class="step reveal" data-delay={String(Math.min(3, i))}>
            <span class="step__no">{p.step}</span>
            <h3 class="step__h">{p.title}</h3>
            <p class="step__en">{p.en}</p>
            <p class="step__desc">{p.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 포트폴리오 ---------------------------------------------------------- -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <p class="label">Portfolio</p>
          <h2 class="h2" style="margin-top:14px">투자 포트폴리오</h2>
        </div>
        <a class="btn btn--ghost" href={url('/portfolio')}>
          전체보기 <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      {portfolio.length === 0 ? (
        <p class="empty reveal">포트폴리오를 준비하고 있습니다.</p>
      ) : (
        <div class="pf reveal">
          {portfolio.map((p) => (
            <a class="pf__item card-surface" href={url(`/portfolio/${p.id}`)}>
              <span class="pf__sector">{p.data.sector}</span>
              <span class="pf__name">{p.data.company}</span>
              {p.data.year && <span class="pf__year num">{p.data.year}</span>}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 공시 / 뉴스 --------------------------------------------------------- -->
  <section class="section section--tint">
    <div class="wrap notice">
      <div class="notice__col">
        <div class="sec-head reveal">
          <div>
            <p class="label">Disclosure</p>
            <h2 class="h3" style="margin-top:12px">경영공시</h2>
          </div>
          <a class="more" href={url('/notice/disclosure')}>더보기 <span aria-hidden="true">→</span></a>
        </div>
        {disclosures.length === 0 ? (
          <p class="empty reveal">등록된 공시가 없습니다.</p>
        ) : (
          <div class="list reveal">
            {disclosures.map((d) => (
              <a class="list__row" href={url(`/notice/disclosure/${d.id}`)}>
                <span class="list__title">{d.data.title}</span>
                <span class="list__meta">{fmt(d.data.date)}</span>
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="notice__col">
        <div class="sec-head reveal">
          <div>
            <p class="label">News</p>
            <h2 class="h3" style="margin-top:12px">뉴스</h2>
          </div>
          <a class="more" href={url('/notice/news')}>더보기 <span aria-hidden="true">→</span></a>
        </div>
        {news.length === 0 ? (
          <p class="empty reveal">등록된 뉴스가 없습니다.</p>
        ) : (
          <div class="list reveal">
            {news.map((n) => (
              <a class="list__row" href={url(`/notice/news/${n.id}`)}>
                <span class="list__title">{n.data.title}</span>
                <span class="list__meta">{fmt(n.data.date)}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- CONTACT ------------------------------------------------------------ -->
  <section class="cta dark-bg">
    <div class="wrap cta__in reveal">
      <div>
        <p class="label label--onDark">Contact</p>
        <h2 class="cta__h">
          투자를 준비하고 계신가요?<br />
          <span>사업계획서를 보내주세요.</span>
        </h2>
        <p class="cta__p">검토 결과는 담당자가 개별적으로 회신드립니다.</p>
        <a class="btn btn--onDark" style="margin-top:34px" href={url('/contact')}>
          투자 문의 <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <dl class="cta__info">
        <div><dt>T</dt><dd class="num">{COMPANY.tel}</dd></div>
        <div><dt>E</dt><dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd></div>
        <div><dt>A</dt><dd>{COMPANY.addressShort}</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  /* ---------- 벤토 그리드 ---------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(148px, auto);
    gap: 14px;
  }
  .bento__tile {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    padding: 26px 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r);
    transition: transform 0.32s var(--ease-out), box-shadow 0.32s var(--ease-out);
  }
  .bento__tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-1); }
  .bento__tile--hero {
    grid-column: span 2;
    grid-row: span 2;
    background: linear-gradient(155deg, #0f1a30 0%, #0a1526 55%, #101c33 100%);
    border-color: transparent;
    color: #fff;
    padding: 34px 36px;
  }
  .bento__orb {
    position: absolute;
    right: -18%;
    bottom: -34%;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(74, 128, 224, 0.5) 0%, transparent 68%);
    pointer-events: none;
  }
  .bento__k {
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .bento__tile--hero .bento__k { color: var(--blue-lift); }
  .bento__big {
    position: relative;
    font-size: clamp(3rem, 7vw, 5.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(120deg, #ffffff 0%, #a8c8ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .bento__big em {
    font-style: normal;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-left: 8px;
    -webkit-text-fill-color: rgba(255, 255, 255, 0.72);
  }
  .bento__note {
    position: relative;
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
    max-width: 30ch;
  }
  .bento__v {
    font-size: clamp(1.375rem, 2.3vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--ink);
  }
  .bento__v--sm { font-size: clamp(1rem, 1.5vw, 1.1875rem); font-weight: 600; }
  @media (max-width: 900px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bento__tile--hero { grid-column: span 2; grid-row: span 1; }
  }

  /* ---------- 업무영역 카드 ---------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(40px, 6vw, 64px);
  }
  .card { padding: clamp(28px, 3vw, 38px); display: flex; flex-direction: column; }
  .card__no {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--grad-blue);
    color: #fff;
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .card:nth-child(2) .card__no { background: linear-gradient(135deg, #1a55bd 0%, #7a5ba8 100%); }
  .card:nth-child(3) .card__no { background: linear-gradient(135deg, #a4494f 0%, #c83c39 100%); }
  .card__h { margin: 22px 0 0; font-size: 1.4375rem; }
  .card__en {
    margin: 6px 0 0;
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--muted-2);
  }
  .card__desc { margin: 18px 0 0; font-size: 0.9375rem; color: var(--muted); line-height: 1.78; }
  .card__list {
    margin: 24px 0 0;
    padding: 20px 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .card__list li { position: relative; padding-left: 17px; font-size: 0.875rem; }
  .card__list li::before {
    content: '';
    position: absolute; left: 0; top: 0.62em;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--red);
    opacity: 0.85;
  }
  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; } }

  /* ---------- 프로세스 (다크) ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
    margin: clamp(44px, 6vw, 68px) 0 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    padding: 26px 22px;
    border-radius: var(--r);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(6px);
    transition: background 0.3s var(--ease), transform 0.3s var(--ease-out), border-color 0.3s var(--ease);
  }
  .step:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(90, 146, 238, 0.55);
    transform: translateY(-4px);
  }
  .step__no {
    display: block;
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--cyan-lift);
  }
  .step__h { margin: 16px 0 0; font-size: 1.0625rem; color: #fff; }
  .step__en {
    margin: 5px 0 0;
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.42);
  }
  .step__desc { margin: 14px 0 0; font-size: 0.875rem; color: rgba(255, 255, 255, 0.62); line-height: 1.72; }
  @media (max-width: 1000px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }

  /* ---------- 섹션 헤더 ---------- */
  .sec-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .more { font-size: 0.875rem; font-weight: 600; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .more:hover { color: var(--blue); }

  /* ---------- 포트폴리오 ---------- */
  .pf { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .pf__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 26px 28px;
    text-decoration: none;
  }
  .pf__sector {
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--blue);
  }
  .pf__name { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.03em; }
  .pf__item:hover .pf__name { color: var(--blue); }
  .pf__year { font-family: Sora, Pretendard, sans-serif; font-size: 0.8125rem; color: var(--muted-2); }

  /* ---------- 공시·뉴스 2단 ---------- */
  .notice {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(36px, 5vw, 56px);
  }
  @media (max-width: 900px) { .notice { grid-template-columns: 1fr; } }

  /* ---------- CTA ---------- */
  .cta__in {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
    padding-block: clamp(70px, 9vw, 116px);
  }
  .cta__h {
    margin: 18px 0 0;
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.28;
    color: #fff;
  }
  .cta__h span { color: rgba(255, 255, 255, 0.5); }
  .cta__p { margin: 20px 0 0; font-size: 0.9375rem; color: rgba(255, 255, 255, 0.6); }
  .cta__info {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 26px 28px;
    border-radius: var(--r);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
  }
  .cta__info > div {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding-block: 12px;
  }
  .cta__info > div + div { border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .cta__info dt {
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--cyan-lift);
    letter-spacing: 0.1em;
  }
  .cta__info dd { margin: 0; font-size: 0.875rem; color: rgba(255, 255, 255, 0.78); }
  .cta__info a { color: inherit; }
  .cta__info a:hover { color: #fff; }
  @media (max-width: 900px) { .cta__in { grid-template-columns: 1fr; } }
</style>
