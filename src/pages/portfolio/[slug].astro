---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { url } from '../../lib/site';

export async function getStaticPaths() {
  const items = (await getCollection('portfolio')).filter((p) => !p.data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.company} description={d.summary ?? `${d.company} — ${d.sector}`}>
  <PageHero en="Portfolio" title={d.company} desc={d.summary} />

  <section class="section">
    <div class="wrap grid-editorial">
      <aside class="meta">
        {d.logo && <img class="meta__logo" src={url(d.logo)} alt={d.company} />}
        <dl class="meta__dl">
          <div><dt>분야</dt><dd>{d.sector}</dd></div>
          {d.stage && <div><dt>단계</dt><dd>{d.stage}</dd></div>}
          {d.year && <div><dt>투자연도</dt><dd class="num">{d.year}</dd></div>}
          {d.website && (
            <div>
              <dt>홈페이지</dt>
              <dd><a href={d.website} target="_blank" rel="noopener noreferrer">바로가기 ↗</a></dd>
            </div>
          )}
        </dl>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    <div class="wrap" style="margin-top:64px">
      <a class="btn btn--ghost" href={url('/portfolio')}>← 포트폴리오 목록</a>
    </div>
  </section>
</Base>

<style>
  .meta__logo { max-width: 180px; margin-bottom: 26px; }
  .meta__dl { margin: 0; border-top: 2px solid var(--ink); }
  .meta__dl > div { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 12px; padding: 14px 2px; border-bottom: 1px solid var(--line); }
  .meta__dl dt { font-size: 0.8125rem; color: var(--muted-2); }
  .meta__dl dd { margin: 0; font-size: 0.875rem; }
  .meta__dl a { color: var(--blue); text-decoration: none; }
</style>
