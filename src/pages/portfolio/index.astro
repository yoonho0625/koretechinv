---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { envOf, type Portfolio } from '../../lib/server';

export const prerender = false;

const env = envOf(Astro.locals);
const items =
  (await env.DB.prepare('SELECT * FROM portfolio WHERE published = 1 ORDER BY sort DESC, invest_year DESC, id DESC').all<Portfolio>()).results ?? [];
const sectors = [...new Set(items.map((i) => i.sector).filter(Boolean))];

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=60');
---

<Base title="포트폴리오" description="코어테크인베스트먼트가 투자한 기업입니다.">
  <PageHero en="Portfolio" title="포트폴리오" desc="기술로 시장의 문제를 푸는 기업들과 함께하고 있습니다." />

  <section class="section">
    <div class="wrap">
      {items.length === 0 ? (
        <div class="empty">
          <p style="font-size:1.125rem;color:var(--ink);margin-bottom:8px;font-weight:600">포트폴리오를 준비하고 있습니다.</p>
          <p style="font-size:0.9375rem">투자 기업이 확정되는 대로 이곳에 공개됩니다.</p>
        </div>
      ) : (
        <>
          {sectors.length > 1 && (
            <div class="filters">
              <button class="filter is-on" type="button" data-filter="*">전체 <span class="num">{items.length}</span></button>
              {sectors.map((s) => (
                <button class="filter" type="button" data-filter={s}>{s} <span class="num">{items.filter((i) => i.sector === s).length}</span></button>
              ))}
            </div>
          )}
          <div class="pf-grid" data-grid>
            {items.map((p) => (
              <a class="pfc card-surface" href={`/portfolio/${p.id}`} data-sector={p.sector}>
                <div class="pfc__top">
                  {p.logo_file_id ? (
                    <img class="pfc__logo" src={`/files/${p.logo_file_id}/logo`} alt="" loading="lazy" />
                  ) : (
                    <span class="pfc__mark" aria-hidden="true">{p.company.slice(0, 1)}</span>
                  )}
                  {p.invest_year && <span class="pfc__year num">{p.invest_year}</span>}
                </div>
                <h2 class="pfc__name">{p.company}</h2>
                <p class="pfc__sector">{p.sector}{p.stage && ` · ${p.stage}`}</p>
                {p.summary && <p class="pfc__sum">{p.summary}</p>}
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .filter {
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-2);
    background: var(--paper);
    color: var(--muted);
    cursor: pointer;
  }
  .filter span { font-size: 0.8125rem; color: var(--muted-2); margin-left: 4px; }
  .filter.is-on { background: var(--ink); border-color: var(--ink); color: #fff; }
  .filter.is-on span { color: rgba(255, 255, 255, 0.6); }
  .pf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .pfc { padding: 28px; text-decoration: none; display: flex; flex-direction: column; }
  .pfc[hidden] { display: none; }
  .pfc__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; }
  .pfc__logo { max-height: 44px; width: auto; max-width: 150px; object-fit: contain; }
  .pfc__mark { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--surface-2); color: var(--blue); font-weight: 700; font-size: 1.125rem; }
  .pfc__year { font-family: Sora, Pretendard, sans-serif; font-size: 0.875rem; color: var(--muted-2); }
  .pfc__name { margin: 22px 0 0; font-size: 1.3125rem; }
  .pfc:hover .pfc__name { color: var(--blue); }
  .pfc__sector { margin: 7px 0 0; font-size: 0.875rem; font-weight: 600; color: var(--red); }
  .pfc__sum { margin: 14px 0 0; font-size: 0.9375rem; color: var(--muted); line-height: 1.7; }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const want = btn.dataset.filter;
      buttons.forEach((b) => b.classList.toggle('is-on', b === btn));
      grid?.querySelectorAll<HTMLElement>('.pfc').forEach((c) => (c.hidden = want !== '*' && c.dataset.sector !== want));
    })
  );
</script>
