---
import Base from '../../layouts/Base.astro';
import { COMPANY, url } from '../../lib/site';
---

<Base title="문의가 접수되었습니다" description="투자 문의가 정상적으로 접수되었습니다.">
  <section class="done">
    <div class="wrap done__in">
      <span class="done__mark" aria-hidden="true">✓</span>
      <h1 class="h1">문의가 접수되었습니다</h1>
      <p class="lead" style="margin-top:18px">
        보내주신 내용을 검토한 뒤 담당자가 개별적으로 회신드리겠습니다.<br />
        추가 자료는 <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a> 로 보내주세요.
      </p>
      <div class="done__btns">
        <a class="btn btn--primary" href={url('/')}>홈으로</a>
        <a class="btn btn--ghost" href={url('/about/overview')}>회사소개 보기</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .done { padding-block: clamp(90px, 14vw, 170px); }
  .done__in { max-width: 640px; }
  .done__mark {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 2px solid var(--blue);
    color: var(--blue);
    font-size: 1.5rem;
    margin-bottom: 28px;
  }
  .done__in a { color: var(--blue); }
  .done__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; }
  .done__btns a { text-decoration: none; }
</style>
