---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---

<Base title="페이지를 찾을 수 없습니다">
  <section class="nf">
    <div class="wrap nf__in">
      <p class="nf__code num">404</p>
      <h1 class="h1">페이지를 찾을 수 없습니다</h1>
      <p class="lead" style="margin-top:16px">
        주소가 변경되었거나 삭제된 페이지입니다. 아래 링크로 이동해 주세요.
      </p>
      <div class="nf__btns">
        <a class="btn btn--primary" href={url('/')}>홈으로</a>
        <a class="btn btn--ghost" href={url('/sitemap')}>사이트맵</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(90px, 14vw, 170px); }
  .nf__in { max-width: 620px; }
  .nf__code {
    font-family: Sora, Pretendard, sans-serif;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 1;
    color: var(--line-2);
    margin: 0 0 18px;
    letter-spacing: -0.04em;
  }
  .nf__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .nf__btns a { text-decoration: none; }
</style>
