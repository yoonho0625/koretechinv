---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { COMPANY, url } from '../../lib/site';
---

<Base title="회사소개" description={`${COMPANY.nameKo}(${COMPANY.nameEn})의 회사 개요와 기업 정보입니다.`}>
  <PageHero
    en="Overview"
    title="회사소개"
    group="About us"
    desc="대한민국 핵심 기술기업의 성장 파트너, 코어테크인베스트먼트입니다."
  />

  <section class="section">
    <div class="wrap grid-editorial reveal">
      <p class="label">About us</p>
      <div>
        <h2 class="h2">
          기술이 사업이 되는<br />모든 단계에 함께합니다.
        </h2>
        <p class="lead" style="margin-top:26px">
          코어테크인베스트먼트는 신기술사업자 및 벤처기업에 대한 다양한 방법의 투자 또는 융자와
          경영 및 기술의 지도를 전문으로 하는 투자기관입니다.
        </p>
        <p class="measure body-muted" style="margin-top:20px">
          우리는 기술의 완성도만을 보지 않습니다. 그 기술이 시장에서 어떤 문제를 풀고,
          어떤 속도로 사업이 될 수 있는지를 함께 검토합니다. 투자 이후에는 경영과 기술 양쪽에서
          필요한 자원을 연결하여 기업이 다음 단계로 넘어가도록 돕습니다.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap grid-editorial reveal">
      <p class="label">Information</p>
      <div class="table-scroll">
        <table class="info">
          <tbody>
            <tr><th scope="row">회사명</th><td>{COMPANY.nameKo}</td></tr>
            <tr><th scope="row">영문명</th><td>{COMPANY.nameEn}</td></tr>
            <tr><th scope="row">대표이사</th><td>{COMPANY.ceo}</td></tr>
            <tr><th scope="row">설립일</th><td class="num">{COMPANY.founded}</td></tr>
            <tr><th scope="row">소재지</th><td>{COMPANY.address}</td></tr>
            <tr><th scope="row">업무영역</th><td>{COMPANY.business}</td></tr>
            <tr><th scope="row">납입자본금</th><td class="num">{COMPANY.capital}</td></tr>
            <tr><th scope="row">주주구성</th><td>{COMPANY.shareholder}</td></tr>
            <tr>
              <th scope="row">연락처</th>
              <td class="num">
                T. {COMPANY.tel} / F. {COMPANY.fax} /
                E. <a href={`mailto:${COMPANY.email}`} style="color:var(--blue)">{COMPANY.email}</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap next reveal">
      <a class="next__card" href={url('/about/philosophy')}>
        <span class="label">Philosophy</span>
        <strong>투자철학</strong>
        <span class="next__arrow" aria-hidden="true">→</span>
      </a>
      <a class="next__card" href={url('/about/history')}>
        <span class="label">History</span>
        <strong>연혁</strong>
        <span class="next__arrow" aria-hidden="true">→</span>
      </a>
      <a class="next__card" href={url('/about/organization')}>
        <span class="label">Organization</span>
        <strong>조직도</strong>
        <span class="next__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .next { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .next__card {
    background: var(--paper);
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    position: relative;
    transition: background 0.2s var(--ease);
  }
  .next__card:hover { background: var(--surface); }
  .next__card strong { font-size: 1.125rem; font-weight: 600; }
  .next__arrow { position: absolute; right: 26px; bottom: 28px; color: var(--muted-2); transition: transform 0.2s var(--ease), color 0.2s var(--ease); }
  .next__card:hover .next__arrow { transform: translateX(4px); color: var(--blue); }
  @media (max-width: 760px) { .next { grid-template-columns: 1fr; } }
</style>
