---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

/**
 * 연혁 — 2026-10 미팅: 설립만 남기고 자본금·유상증자는 싣지 않는다.
 * 새 연혁은 맨 위 연도 블록의 items 에 추가하면 된다(최근 것이 위로).
 */
const HISTORY = [
  {
    year: '2026',
    items: [{ date: '06.05', title: '주식회사 코어테크인베스트먼트 설립' }],
  },
];
---

<Base title="연혁" description="코어테크인베스트먼트의 설립과 주요 연혁입니다.">
  <PageHero en="History" title="연혁" group="About us" desc="대한민국 핵심 기술기업과 함께 걸어갈 첫걸음을 내디뎠습니다." />

  <section class="section">
    <div class="wrap">
      {HISTORY.map((block) => (
        <div class="era reveal">
          <p class="era__year num">{block.year}</p>
          <ol class="era__list">
            {block.items.map((it) => (
              <li class="ev">
                <span class="ev__dot" aria-hidden="true"></span>
                <span class="ev__date num">{block.year}.{it.date}</span>
                <h2 class="ev__title">{it.title}</h2>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .era {
    display: grid;
    grid-template-columns: minmax(140px, 260px) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }
  .era__year {
    margin: 0;
    font-family: Sora, Pretendard, sans-serif;
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    background: linear-gradient(160deg, var(--ink) 0%, var(--blue) 120%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .era__list { margin: 0; padding: 0 0 0 30px; list-style: none; position: relative; }
  .era__list::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(to bottom, var(--blue), var(--line));
    border-radius: 2px;
  }
  .ev {
    position: relative;
    padding: 26px 30px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r);
    box-shadow: var(--shadow-1);
  }
  .ev + .ev { margin-top: 14px; }
  .ev__dot {
    position: absolute;
    left: -30px;
    top: 34px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 5px var(--red-100);
  }
  .ev__date {
    font-family: Sora, Pretendard, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--blue);
    letter-spacing: 0.02em;
  }
  .ev__title { margin: 8px 0 0; font-size: clamp(1.25rem, 2.2vw, 1.625rem); }
  @media (max-width: 780px) {
    .era { grid-template-columns: 1fr; gap: 18px; }
  }
</style>
