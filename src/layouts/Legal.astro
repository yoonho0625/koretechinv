---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string;
  en: string;
  desc?: string;
  /** 법무 검토 전 초안이면 true — 페이지 상단에 안내가 뜬다. */
  draft?: boolean;
  effective?: string;
}
const { title, en, desc, draft = false, effective } = Astro.props;
---

<Base title={title} description={desc ?? title}>
  <PageHero en={en} title={title} desc={desc} />

  <section class="section">
    <div class="wrap legal">
      {draft && (
        <aside class="draft" role="note">
          <strong>검토 전 초안입니다.</strong>
          이 문서는 홈페이지 구축을 위해 표준 양식으로 작성한 초안으로, 법무 검토를 마친 확정본으로 교체해야 합니다.
        </aside>
      )}

      {effective && <p class="legal__eff num">시행일 {effective}</p>}

      <div class="prose legal__body">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .legal { max-width: 860px; }
  .draft {
    display: block;
    padding: 16px 20px;
    margin-bottom: 34px;
    border-left: 3px solid var(--red);
    background: #fdf3f2;
    font-size: 0.875rem;
    color: #7d3a37;
    line-height: 1.7;
  }
  .draft strong { display: block; color: var(--red); margin-bottom: 3px; }
  .legal__eff {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--muted-2);
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 34px;
  }
  .legal__body :global(h2) {
    font-size: 1.125rem;
    padding-top: 1.4em;
    margin-top: 1.6em;
    border-top: 1px solid var(--line);
  }
  .legal__body :global(h2:first-child) { border-top: 0; padding-top: 0; margin-top: 0; }
</style>
