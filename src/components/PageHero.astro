---
import { NAV, url } from '../lib/site';

interface Props {
  title: string;
  en: string;
  desc?: string;
  /** 상단 대메뉴 라벨 — 하위 탭을 자동으로 그린다 */
  group?: string;
}
const { title, en, desc, group } = Astro.props;

const parent = group ? NAV.find((n) => n.label === group) : undefined;
const here = Astro.url.pathname.replace(/\/$/, '');
---

<section class="ph">
  <div class="wrap ph__in">
    <p class="ph__en">{en}</p>
    <h1 class="ph__h">{title}</h1>
    {desc && <p class="ph__desc">{desc}</p>}
  </div>

  {parent?.children && (
    <nav class="ph__tabs" aria-label="하위 메뉴">
      <div class="wrap ph__tabs-in">
        {parent.children.map((c) => {
          const on = here === url(c.href).replace(/\/$/, '');
          return (
            <a class:list={['ph__tab', on && 'is-on']} href={url(c.href)} aria-current={on ? 'page' : undefined}>
              {c.label}
            </a>
          );
        })}
      </div>
    </nav>
  )}
</section>

<style>
  /* 시안 B: 밝은 종이 위 큰 먹색 제목 + 빨간 점 라벨 + 검은 알약 탭 */
  .ph { position: relative; background: var(--canvas); border-bottom: 1px solid var(--line); }
  .ph__in { position: relative; padding-block: clamp(64px, 9vw, 120px) clamp(34px, 4.5vw, 52px); }
  .ph__en {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ph__en::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--red); }
  .ph__h {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.055em;
    color: var(--ink);
  }
  .ph__desc {
    margin: 22px 0 0;
    max-width: 46em;
    font-size: clamp(1rem, 1.35vw, 1.1875rem);
    line-height: 1.74;
    color: #4a4245;
  }

  .ph__tabs { position: relative; }
  .ph__tabs-in { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding-block: 0 26px; }
  .ph__tabs-in::-webkit-scrollbar { display: none; }
  .ph__tab {
    flex: none;
    padding: 11px 22px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-2);
    background: var(--paper);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.22s var(--ease), background 0.22s var(--ease), color 0.22s var(--ease);
  }
  .ph__tab:hover { border-color: var(--ink); }
  .ph__tab.is-on { color: #fff; background: var(--ink); border-color: var(--ink); }
  /* 휴대폰: PC처럼 탭 4개가 한 줄에 다 보이게 */
  @media (max-width: 600px) {
    .ph__tabs-in { gap: 6px; }
    .ph__tab { padding: 9px 14px; font-size: 0.875rem; }
  }
</style>
