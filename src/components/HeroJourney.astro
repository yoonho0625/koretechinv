---
/**
 * 메인 히어로 — 스크롤 3D 여정
 *   1막 대한민국   : 흩어진 입자가 한반도 지형으로 모인다   (원래의 블루→시안 + 골드 스파크)
 *   2막 핵심       : 한반도가 구형 코어로 재배열된다
 *   3막 기술       : 코어가 회전하며 열린다
 *   4막 KoreTech   : 입자가 실제 CI 워드마크 모양으로 재조합된다
 *   5막 피날레     : 입자는 반짝이는 물결로 흘러내리고, 선명한 로고가 떠오른다
 *
 * 4·5막의 로고 모양과 색은 /brand/wordmark-dark.png 픽셀을 런타임에 샘플링해서 만든다.
 * 로고 파일을 교체하면 이 장면도 자동으로 따라간다.
 */
import { url } from '../lib/site';
const wordmark = url('/brand/wordmark-dark.png');
---

<section class="hero" data-hero>
  <div class="hero__pin">
    <canvas class="hero__gl" data-gl data-logo={wordmark} aria-hidden="true"></canvas>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="hero__acts">
      <div class="act" data-act="0">
        <p class="act__no">01 — KOREA</p>
        <h1 class="act__h">대한민국<span class="dot">.</span></h1>
        <p class="act__p">기술로 미래를 여는 기업들이 이 땅 곳곳에서 성장하고 있습니다.</p>
      </div>

      <div class="act" data-act="1">
        <p class="act__no">02 — CORE</p>
        <p class="act__h">핵심<span class="dot">.</span></p>
        <p class="act__p">그중 산업의 중심이 될 핵심 기술기업을 발굴하고 집중합니다.</p>
      </div>

      <div class="act" data-act="2">
        <p class="act__no">03 — TECH</p>
        <p class="act__h">기술<span class="dot">.</span></p>
        <p class="act__p">투자와 융자, 경영·기술 지도로 기술이 사업이 되도록 함께합니다.</p>
      </div>

      <!-- 4막: 입자가 워드마크를 그린다. 글자는 입자가 맡으므로 라벨만 둔다. -->
      <div class="act act--center" data-act="3">
        <p class="act__no act__no--c">04 — KORETECH</p>
      </div>

      <!-- 5막: 선명한 로고 + 반짝이는 물결 -->
      <div class="act act--finale" data-act="4" data-finale>
        <div class="finale__logo" style={`--mask:url(${wordmark})`}>
          <img src={wordmark} alt="KoreTech" width="700" height="121" />
          <span class="finale__shine" aria-hidden="true"></span>
        </div>
        <div class="finale__text">
          <p class="finale__word">INVESTMENT</p>
          <p class="finale__tag">대한민국 <b>핵심 기술기업</b>의 성장 파트너</p>
          <a class="finale__cta" href={url('/about/overview')}>회사소개 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>

    <ol class="hero__dots" aria-hidden="true">
      <li data-dot="0" class="is-on"></li><li data-dot="1"></li><li data-dot="2"></li>
      <li data-dot="3"></li><li data-dot="4"></li>
    </ol>

    <p class="hero__scroll" data-scrollhint><span>SCROLL</span><i></i></p>
  </div>
</section>

<style>
  .hero { position: relative; height: 520vh; background: var(--ground); }
  .hero__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--ground);
  }
  .hero__gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hero__veil {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 70% 64% at 50% 48%, transparent 0%, rgba(8, 11, 18, 0.9) 100%);
  }

  .hero__acts { position: absolute; inset: 0; pointer-events: none; }

  .act {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }
  /* 스크립트가 붙기 전에도 1막은 읽히는 상태여야 한다 */
  .act[data-act='0'] { opacity: 1; transform: none; }
  /* 4막 라벨은 입자 워드마크를 가리지 않도록 아래쪽에 둔다 */
  .act--center { align-items: center; justify-content: flex-end; padding-bottom: 16svh; }

  .act__no {
    margin: 0 0 20px;
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    color: var(--cyan-lift);
  }
  .act__no--c { margin: 0; color: rgba(255, 255, 255, 0.45); }
  .act__h {
    margin: 0;
    font-size: clamp(3.25rem, 9vw, 8rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.05em;
    color: #fff;
  }
  .act__h .dot { color: var(--red-lift); }
  .act__p {
    margin: 26px 0 0;
    max-width: 30ch;
    font-size: clamp(1rem, 1.55vw, 1.375rem);
    font-weight: 300;
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.74);
  }

  /* ---------- 5막 피날레 ---------- */
  .act--finale { padding: 0; }
  .finale__logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: var(--logo-w, 46vw);
  }
  .finale__logo img { width: 100%; filter: drop-shadow(0 6px 34px rgba(90, 146, 238, 0.45)); }

  /* 반짝이는 물결 — 로고 글자 안쪽만 빛이 훑고 지나간다 */
  .finale__shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    background: linear-gradient(
      104deg,
      transparent 40%,
      rgba(255, 255, 255, 0.35) 46%,
      rgba(255, 255, 255, 0.95) 50%,
      rgba(160, 214, 255, 0.5) 55%,
      transparent 62%
    );
    background-size: 280% 100%;
    background-repeat: no-repeat;
    animation: heroShine 3.6s cubic-bezier(0.5, 0, 0.2, 1) infinite;
  }
  @keyframes heroShine {
    0% { background-position: 190% 0; }
    58%, 100% { background-position: -90% 0; }
  }
  @media (prefers-reduced-motion: reduce) { .finale__shine { animation: none; opacity: 0; } }

  .finale__text {
    position: absolute;
    left: 0;
    right: 0;
    /* 로고(가로세로비 0.173) 아래로 붙인다 */
    top: calc(50% + (var(--logo-w, 46vw) * 0.173) / 2 + 22px);
    text-align: center;
    padding: 16px var(--gutter) 24px;
    /* 물결 입자 위에서도 글자가 읽히도록 부드러운 음영을 깐다 */
    background: radial-gradient(56% 120% at 50% 44%, rgba(8, 11, 18, 0.82) 0%, rgba(8, 11, 18, 0) 72%);
  }
  .finale__word {
    margin: 0;
    font-family: Sora, Pretendard, sans-serif;
    font-size: clamp(0.8125rem, 1.55vw, 1.25rem);
    font-weight: 300;
    letter-spacing: 0.54em;
    text-indent: 0.54em;
    color: rgba(255, 255, 255, 0.9);
  }
  .finale__tag {
    margin: 20px 0 0;
    font-size: clamp(0.9375rem, 1.35vw, 1.1875rem);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.72);
  }
  .finale__tag b { font-weight: 600; color: #fff; }
  .finale__cta {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    padding: 14px 32px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.24s var(--ease), color 0.24s var(--ease),
      border-color 0.24s var(--ease), transform 0.24s var(--ease);
  }
  .finale__cta:hover { background: #fff; color: var(--ground); border-color: #fff; transform: translateY(-2px); }

  .hero__dots {
    position: absolute;
    right: clamp(16px, 3vw, 40px);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 13px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero__dots li {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    transition: background 0.3s var(--ease), box-shadow 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .hero__dots li.is-on {
    background: var(--cyan-lift);
    box-shadow: 0 0 12px var(--cyan-lift);
    transform: scale(1.35);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 30px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: Sora, Pretendard, sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.5);
  }
  .hero__scroll i {
    display: block; width: 1px; height: 40px;
    background: linear-gradient(to bottom, var(--cyan-lift), transparent);
    animation: heroDrop 1.9s ease-in-out infinite;
  }
  @keyframes heroDrop {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  /* WebGL이 없거나 모션을 줄이는 환경 — 피날레만 정지 화면으로 */
  .hero.is-static { height: auto; }
  .hero.is-static .hero__pin { position: relative; height: auto; min-height: 76vh; }
  .hero.is-static .hero__gl,
  .hero.is-static .hero__dots,
  .hero.is-static .hero__scroll { display: none; }
  .hero.is-static .hero__acts {
    position: static;
    display: grid;
    place-items: center;
    padding-block: clamp(90px, 14vw, 150px);
  }
  .hero.is-static .act { display: none; }
  .hero.is-static .act--finale {
    display: flex; position: static; inset: auto; opacity: 1; transform: none;
    flex-direction: column; align-items: center;
  }
  .hero.is-static .finale__logo { position: static; transform: none; width: min(430px, 66vw); }
  .hero.is-static .finale__text { position: static; margin-top: 26px; }
  .hero.is-static .hero__veil {
    background: radial-gradient(ellipse 70% 70% at 50% 46%, rgba(18, 68, 157, 0.3) 0%, transparent 70%);
  }

  @media (max-width: 700px) {
    .hero { height: 460vh; }
    .act__p { max-width: 24ch; }
    .finale__text { top: calc(50% + (var(--logo-w, 70vw) * 0.173) / 2 + 22px); }
  }
</style>

<script>
  import * as THREE from 'three';

  const section = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-gl]');

  if (section && canvas) {
    const acts = Array.from(section.querySelectorAll<HTMLElement>('.act'));
    const dots = Array.from(section.querySelectorAll<HTMLElement>('[data-dot]'));
    const hint = section.querySelector<HTMLElement>('[data-scrollhint]');
    const finale = section.querySelector<HTMLElement>('[data-finale]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let renderer: THREE.WebGLRenderer | null = null;
    if (!reduce) {
      try {
        renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: false,
          powerPreference: 'high-performance',
        });
      } catch {
        renderer = null;
      }
    }

    if (!renderer) {
      section.classList.add('is-static');
    } else {
      const gl = renderer;
      const isMobile = window.innerWidth < 768;
      gl.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.5 : 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
      camera.position.set(0, 0, 10);

      // ---------- 한반도 윤곽 (경도/위도) ----------
      const OUTLINE: [number, number][] = [
        [130.7, 42.3], [129.7, 41.7], [129.4, 40.5], [128.4, 39.9], [127.6, 39.4], [128.3, 38.6],
        [129.0, 37.6], [129.4, 36.8], [129.4, 36.0], [129.2, 35.4], [128.5, 35.0], [127.7, 34.7],
        [126.9, 34.4], [126.3, 34.6], [126.4, 35.2], [126.6, 35.8], [126.5, 36.5], [126.2, 36.9],
        [126.7, 37.5], [126.3, 37.9], [125.2, 38.0], [124.7, 38.5], [125.3, 39.0], [125.3, 39.6],
        [124.4, 40.0], [125.0, 40.6], [126.0, 41.2], [126.9, 41.7], [127.5, 41.5], [128.2, 41.4],
        [128.8, 42.0], [129.9, 42.9],
      ];
      const inside = (x: number, y: number) => {
        let c = false;
        for (let i = 0, j = OUTLINE.length - 1; i < OUTLINE.length; j = i++) {
          const [xi, yi] = OUTLINE[i];
          const [xj, yj] = OUTLINE[j];
          if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) c = !c;
        }
        return c;
      };
      const CX = 127.4, CY = 38.0, LON_SQUEEZE = 0.8, SCALE = 0.56;

      const N = isMobile ? 7000 : 17000;
      const korea = new Float32Array(N * 3);
      const core = new Float32Array(N * 3);
      const logo = new Float32Array(N * 3);
      const seed = new Float32Array(N);
      const kind = new Float32Array(N);     // 1 = 골드 스파크 (원래의 반짝임)
      const toneLogo = new Float32Array(N); // 4·5막 색: 로고 픽셀에서 샘플링 (0 블루 / 1 레드)

      let i = 0;
      while (i < N) {
        let lon: number, lat: number;
        if (i < N * 0.028) {
          const a = Math.random() * Math.PI * 2;
          const r = Math.sqrt(Math.random());
          lon = 126.55 + Math.cos(a) * r * 0.38;
          lat = 33.4 + Math.sin(a) * r * 0.14; // 제주
        } else {
          lon = 124 + Math.random() * 7.2;
          lat = 33.8 + Math.random() * 9.4;
          if (!inside(lon, lat)) continue;
        }
        korea[i * 3] = (lon - CX) * LON_SQUEEZE * SCALE;
        korea[i * 3 + 1] = (lat - CY) * SCALE;
        korea[i * 3 + 2] = (Math.random() - 0.5) * 0.16;

        const k = i + 0.5;
        const phi = Math.acos(1 - (2 * k) / N);
        const th = Math.PI * (1 + Math.sqrt(5)) * k;
        const rr = i % 5 === 0 ? 2.05 * Math.cbrt(Math.random()) : 2.05;
        core[i * 3] = rr * Math.cos(th) * Math.sin(phi);
        core[i * 3 + 1] = rr * Math.sin(th) * Math.sin(phi);
        core[i * 3 + 2] = rr * Math.cos(phi);

        // 로고 샘플링 전까지는 코어와 같은 자리 (샘플링 실패 시의 폴백)
        logo[i * 3] = core[i * 3];
        logo[i * 3 + 1] = core[i * 3 + 1];
        logo[i * 3 + 2] = core[i * 3 + 2];

        seed[i] = Math.random();
        kind[i] = Math.random() < 0.04 ? 1 : 0;
        toneLogo[i] = 0;
        i++;
      }

      const geo = new THREE.BufferGeometry();
      const logoAttr = new THREE.BufferAttribute(logo, 3);
      const toneLogoAttr = new THREE.BufferAttribute(toneLogo, 1);
      geo.setAttribute('position', new THREE.BufferAttribute(korea, 3));
      geo.setAttribute('aCore', new THREE.BufferAttribute(core, 3));
      geo.setAttribute('aLogo', logoAttr);
      geo.setAttribute('aSeed', new THREE.BufferAttribute(seed, 1));
      geo.setAttribute('aKind', new THREE.BufferAttribute(kind, 1));
      geo.setAttribute('aToneLogo', toneLogoAttr);

      const U = {
        uTime: { value: 0 },
        uMorph: { value: 0 },   // 0 한반도 → 1 코어 → 2 로고
        uWave: { value: 0 },    // 5막: 로고 → 반짝이는 물결
        uIntro: { value: 0 },
        uPR: { value: gl.getPixelRatio() },
        // 로고 좌표는 가로폭 1.0 으로 정규화해 두고 화면 비율에 맞춰 키운다.
        // 샘플링 전에는 aLogo 가 코어 좌표(폴백)이므로 1 로 둔다.
        uLogoScale: { value: 1 },
        // 5막 물결이 내려가는 거리(월드 단위) — 화면 세로의 약 26%
        uWaveDrop: { value: 1.95 },
        // 1~3막: 원래의 블루 → 시안 + 골드 스파크
        uBlue: { value: new THREE.Color('#3b82f6') },
        uCyan: { value: new THREE.Color('#22d3ee') },
        uGold: { value: new THREE.Color('#c9a961') },
        // 4~5막: 실제 로고 색 (어두운 배경에서 또렷하게 보이도록 밝기를 올린 값)
        uLogoBlue: { value: new THREE.Color('#79a8f5') },
        uLogoRed: { value: new THREE.Color('#f0736e') },
      };
      let logoReady = false;

      const material = new THREE.ShaderMaterial({
        uniforms: U,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        vertexShader: /* glsl */ `
          attribute vec3 aCore;
          attribute vec3 aLogo;
          attribute float aSeed;
          attribute float aKind;
          attribute float aToneLogo;
          uniform float uTime, uMorph, uWave, uIntro, uPR, uLogoScale, uWaveDrop;
          varying float vKind, vDepth, vStage, vGlow, vToneLogo, vSpark;
          float ease(float t){ return t * t * (3.0 - 2.0 * t); }
          void main(){
            vec3 scatter = position + vec3(sin(aSeed * 91.0), cos(aSeed * 67.0), sin(aSeed * 53.0)) * 6.5;
            float ti = ease(clamp((uIntro - aSeed * 0.4) / 0.6, 0.0, 1.0));
            vec3 p0 = mix(scatter, position, ti);

            float m1 = ease(clamp(uMorph - aSeed * 0.22, 0.0, 1.0));
            float m2 = ease(clamp(uMorph - 1.0 - aSeed * 0.22, 0.0, 1.0));
            float m3 = ease(clamp(uWave - aSeed * 0.30, 0.0, 1.0));

            // 5막: 워드마크가 가로로 퍼지며 사인파를 그리는 물결이 된다
            float phase = aLogo.x * 24.0 + uTime * 1.9;
            vec3 wave = vec3(
              aLogo.x * 1.30,
              aLogo.y * 0.14 + 0.055 * sin(phase),
              aLogo.z * 0.6 + 0.03 * cos(phase * 0.7)
            );
            vec3 late = mix(aLogo, wave, m3) * uLogoScale;
            // 화면 비율과 무관하게 항상 글자 아래로 내려가도록 월드 단위로 이동한다
            late.y -= uWaveDrop * m3;

            vec3 p = mix(p0, aCore, m1);
            p = mix(p, late, m2);

            p += 0.045 * vec3(
              sin(uTime + aSeed * 41.0),
              cos(uTime * 1.2 + aSeed * 33.0),
              sin(uTime * 0.8 + aSeed * 21.0)
            ) * (1.0 - m3 * 0.6);

            vec4 mv = modelViewMatrix * vec4(p, 1.0);
            vDepth = -mv.z;
            vKind = aKind;
            vStage = m2;
            vToneLogo = aToneLogo;
            vGlow = m1 * (1.0 - m2) + m2;
            // 물결 마루에서 반짝인다
            vSpark = pow(max(0.0, sin(phase)), 10.0) * m3;

            gl_PointSize = ((aKind > 0.5 ? 3.1 : 1.8) + m2 * 0.95 + vSpark * 2.2) * uPR * (10.0 / vDepth);
            gl_Position = projectionMatrix * mv;
          }
        `,
        fragmentShader: /* glsl */ `
          uniform vec3 uBlue, uCyan, uGold, uLogoBlue, uLogoRed;
          varying float vKind, vDepth, vStage, vGlow, vToneLogo, vSpark;
          void main(){
            vec2 c = gl_PointCoord - 0.5;
            float r = length(c);
            if (r > 0.5) discard;
            float a = smoothstep(0.5, 0.04, r);

            // 1~3막: 원래의 블루 → 시안, 일부는 골드 스파크
            vec3 base = mix(uBlue, uCyan, 0.18 + 0.82 * smoothstep(0.0, 1.0, vGlow));
            if (vKind > 0.5) base = uGold;
            // 4~5막: 실제 로고 색으로 넘어간다
            vec3 logoCol = mix(uLogoBlue, uLogoRed, vToneLogo);
            vec3 col = mix(base, logoCol, vStage);
            col = mix(col, vec3(1.0), vSpark * 0.85);

            float alpha = a * (0.86 + 0.14 * vStage + vSpark * 0.4) * smoothstep(17.0, 6.0, vDepth);
            gl_FragColor = vec4(col, alpha);
          }
        `,
      });

      const group = new THREE.Group();
      group.add(new THREE.Points(geo, material));
      scene.add(group);

      // ---------- 4·5막: 실제 로고 PNG를 샘플링해 입자 좌표·색을 만든다 ----------
      const logoImg = new Image();
      logoImg.decoding = 'async';
      logoImg.onload = () => {
        const cv = document.createElement('canvas');
        const w = (cv.width = logoImg.naturalWidth);
        const h = (cv.height = logoImg.naturalHeight);
        const ctx = cv.getContext('2d', { willReadFrequently: true });
        if (!ctx || !w || !h) return;
        ctx.drawImage(logoImg, 0, 0);

        let data: Uint8ClampedArray;
        try {
          data = ctx.getImageData(0, 0, w, h).data;
        } catch {
          return; // 캔버스가 오염되면 코어 폴백을 유지한다
        }

        const scale = 1 / w; // 가로폭 1.0 으로 정규화 (실제 크기는 uLogoScale 이 정한다)
        let placed = 0;
        let guard = 0;
        const maxTries = N * 300;
        while (placed < N && guard < maxTries) {
          guard++;
          const x = (Math.random() * w) | 0;
          const y = (Math.random() * h) | 0;
          const idx = (y * w + x) * 4;
          if (data[idx + 3] < 130) continue;
          logo[placed * 3] = (x - w / 2) * scale;
          logo[placed * 3 + 1] = (h / 2 - y) * scale;
          logo[placed * 3 + 2] = (Math.random() - 0.5) * 0.16;
          const r = data[idx], g = data[idx + 1], b = data[idx + 2];
          toneLogo[placed] = r > g + 26 && r > b + 26 ? 1 : 0;
          placed++;
        }
        if (placed < N * 0.4) return; // 샘플이 너무 적으면 폴백 유지

        // 남는 입자는 로고 뒤로 옅게 흩뿌려 배경을 만든다 (같은 정규화 공간)
        for (let k = placed; k < N; k++) {
          const a = Math.random() * Math.PI * 2;
          const rad = 0.5 + Math.random() * 0.42;
          logo[k * 3] = Math.cos(a) * rad;
          logo[k * 3 + 1] = Math.sin(a) * rad * 0.34;
          logo[k * 3 + 2] = (Math.random() - 0.5) * 0.18;
          toneLogo[k] = Math.random() < 0.3 ? 1 : 0;
        }
        logoAttr.needsUpdate = true;
        toneLogoAttr.needsUpdate = true;
        logoReady = true;
        fitLogo();
      };
      logoImg.src = canvas.dataset.logo ?? '';

      // ---------- 리사이즈 ----------
      // 4막 카메라 거리(9.1)에서 화면에 보이는 가로폭에 맞춰 로고 크기를 정하고,
      // 5막 HTML 로고가 입자 워드마크와 정확히 같은 자리·크기에 오도록 CSS 변수도 맞춘다.
      const fitLogo = () => {
        const visibleW = 2 * 9.1 * Math.tan((45 * Math.PI) / 360) * camera.aspect;
        const worldW = Math.min(7.4, visibleW * 0.82);
        if (logoReady) U.uLogoScale.value = worldW;
        finale?.style.setProperty('--logo-w', `${(worldW / visibleW) * window.innerWidth}px`);
      };
      const resize = () => {
        const w = section.clientWidth;
        const h = Math.max(window.innerHeight, 560);
        gl.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        fitLogo();
      };
      resize();
      window.addEventListener('resize', resize);

      // ---------- 스크롤 진행도 ----------
      let progress = 0;
      const readProgress = () => {
        const rect = section.getBoundingClientRect();
        const total = section.offsetHeight - window.innerHeight;
        progress = total <= 0 ? 0 : Math.min(1, Math.max(0, -rect.top / total));
      };
      readProgress();
      window.addEventListener('scroll', readProgress, { passive: true });
      window.addEventListener('resize', readProgress);

      const RANGES: [number, number][] = [
        [0.0, 0.19],  // 대한민국
        [0.28, 0.44], // 핵심
        [0.52, 0.68], // 기술
        [0.74, 0.82], // KORETECH 라벨
        [0.88, 1.01], // 피날레
      ];
      const bandOpacity = (p: number, a: number, b: number) => {
        const fade = 0.045;
        if (p < a - fade || p > b + fade) return 0;
        if (p < a) return (p - (a - fade)) / fade;
        if (p > b) return Math.max(0, 1 - (p - b) / fade);
        return 1;
      };
      const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

      const mouse = { x: 0, y: 0, tx: 0, ty: 0 };
      window.addEventListener('pointermove', (e) => {
        mouse.tx = (e.clientX / window.innerWidth) * 2 - 1;
        mouse.ty = -((e.clientY / window.innerHeight) * 2 - 1);
      });

      const clock = new THREE.Clock();
      const introStart = performance.now();
      let lastAct = -1;

      const frame = () => {
        const t = clock.getElapsedTime();
        U.uTime.value = t;
        U.uIntro.value = Math.min(1, (performance.now() - introStart) / 2200);

        const p = progress;
        const m1 = clamp01((p - 0.2) / 0.14);  // 한반도 → 코어
        const m2 = clamp01((p - 0.66) / 0.12); // 코어 → 워드마크
        const m3 = clamp01((p - 0.84) / 0.11); // 워드마크 → 물결
        U.uMorph.value = m1 + m2;
        U.uWave.value = m3;

        mouse.x += (mouse.tx - mouse.x) * 0.05;
        mouse.y += (mouse.ty - mouse.y) * 0.05;

        // 카메라 — 지도로 다가갔다가 코어에서 물러선다
        const zApproach = 10 - 2.4 * clamp01(p / 0.2);
        const zCore = zApproach * (1 - m1) + 9.6 * m1;
        camera.position.z = zCore * (1 - m2) + 9.1 * m2;
        camera.lookAt(0, 0, 0);

        // 로고 단계에서는 정면을 유지한다 (자전은 코어 단계에서만)
        const spin = m1 * (1 - m2);
        group.rotation.y = mouse.x * 0.22 + t * 0.16 * spin + Math.sin(t * 0.5) * 0.04 * m2 * (1 - m3);
        group.rotation.x = -mouse.y * 0.13 - 0.3 * clamp01(p / 0.2) * (1 - m1);

        let current = 0;
        for (let idx = 0; idx < acts.length; idx++) {
          const o = bandOpacity(p, RANGES[idx][0], RANGES[idx][1]);
          acts[idx].style.opacity = String(o);
          acts[idx].style.transform = `translateY(${(1 - o) * 18}px)`;
          if (o > 0.5) current = idx;
        }
        if (current !== lastAct) {
          lastAct = current;
          dots.forEach((d, idx) => d.classList.toggle('is-on', idx === current));
        }
        if (hint) hint.style.opacity = String(Math.max(0, 1 - p / 0.06));

        gl.render(scene, camera);
        requestAnimationFrame(frame);
      };
      frame();
    }
  }
</script>
